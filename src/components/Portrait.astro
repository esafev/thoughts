---
import DitheredImage from '@/components/DitheredImage.astro';
import { SITE_TITLE } from '@/consts';

export interface Props {
  light: string;
  dark?: string;
}

const { light, dark } = Astro.props;
---

<a href='/'>
  <DitheredImage {light} {dark} alt={SITE_TITLE} width={96} height={96} loading='eager' />
</a>

<style>
  a {
    display: inline-block;
    vertical-align: top;

    &:focus-visible {
      background: none;
      box-shadow: none;
      outline: 2px solid var(--theme-text);
      outline-offset: 4px;
    }
  }

  a :global(img) {
    display: block;
  }
</style>
