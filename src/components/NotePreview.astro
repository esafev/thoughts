---
import type { Note } from '@/types/note';
import { getNoteSlug } from '@/lib/notes';

export interface Props {
  note: Note;
}

const {
  note,
} = Astro.props;

const {
  data: {
    title,
  }
} = note;
const slug = getNoteSlug(note);
---

<li>
  <a href={`/notes/${slug}`}>{title}</a>
</li>

<style>
  li {
    hyphens: manual;
  }

  li:not(:first-child) {
    margin-top: .5em;
  }
</style>
