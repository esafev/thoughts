---
import type { ImageMetadata } from 'astro';

type Source = ImageMetadata | string;

export interface Props {
  light: Source;
  dark?: Source;
  alt: string;
  width?: number;
  height?: number;
  loading?: 'eager' | 'lazy';
}

const { light, dark, alt, loading = 'lazy' } = Astro.props;
const src = (image: Source) => (typeof image === 'string' ? image : image.src);
const size = typeof light === 'string' ? {} : { width: light.width, height: light.height };
const { width = size.width, height = size.height } = Astro.props;
---

<picture>
  {dark && <source srcset={src(dark)} media='(prefers-color-scheme: dark)' />}
  <img src={src(light)} {alt} {width} {height} {loading} decoding='async' />
</picture>
