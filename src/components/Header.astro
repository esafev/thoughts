---
import Portrait from '@/components/Portrait.astro';
import { PORTRAIT, SITE_TITLE } from '@/consts';

export interface Props {
  title?: string;
}

const { title } = Astro.props;
---

<header>
  {title ? (
    <h1>
      {title === SITE_TITLE && PORTRAIT ? <Portrait {...PORTRAIT} /> : <a href='/'>{title}</a>}
    </h1>
  ) : (
    <a class='back' href='/'><span aria-hidden='true'>↩</span>Index</a>
  )}
</header>

<style>
  h1 {
    font-size: 1em;
  }

  a {
    color: var(--theme-sub-text);

    &:hover {
      color: var(--theme-sub-text);
    }

    &:focus-visible {
      color: var(--theme-bg);
    }
  }

  h1 a {
    text-decoration: none;
  }

  .back span {
    display: inline-block;
    margin-inline-end: 1ch;
  }
</style>
