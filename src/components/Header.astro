---
import Portrait from '@/components/Portrait.astro';
import { SITE_TITLE } from '@/consts';

export interface Props {
  title?: string;
}

const { title } = Astro.props;
---

<header>
  {title ? (
    <h1>
      {title === SITE_TITLE ? <Portrait /> : <a href='/'>{title}</a>}
    </h1>
  ) : (
    <a href='/'>↩ Index</a>
  )}
</header>

<style>
  h1 {
    font-size: 1em;
  }

  a {
    text-decoration: none;
    color: var(--theme-sub-text);

    &:hover {
      color: var(--theme-sub-text);
    }

    &:focus-visible {
      color: var(--theme-bg);
    }
  }
</style>
