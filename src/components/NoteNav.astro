---
import type { CollectionEntry } from 'astro:content';

export interface Props {
  prev?: CollectionEntry<'notes'>;
  next?: CollectionEntry<'notes'>;
}

const { prev, next } = Astro.props;
---

<nav>
  {prev && (
    <a class='prev' href={`/notes/${prev.id}/`} rel='prev'>
      <span aria-hidden='true'>←</span>{prev.data.title}
    </a>
  )}
  {next && (
    <a class='next' href={`/notes/${next.id}/`} rel='next'>
      {next.data.title}<span aria-hidden='true'>→</span>
    </a>
  )}
</nav>

<style>
  nav {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 2ch;

    margin-top: 3em;

    hyphens: manual;
  }

  a {
    position: relative;
    max-width: 100%;
    overflow: hidden;

    color: var(--theme-sub-text);
    white-space: nowrap;
    text-overflow: ellipsis;

    &:hover {
      color: var(--theme-text);
    }

    &:focus-visible {
      color: var(--theme-bg);
    }
  }

  span {
    position: absolute;
    inset-block-start: 0;
  }

  .prev {
    justify-self: start;
    padding-inline-start: 2ch;

    span {
      inset-inline-start: 0;
    }
  }

  .next {
    grid-column: 2;
    justify-self: end;
    padding-inline-end: 2ch;

    span {
      inset-inline-end: 0;
    }
  }

  a:only-child {
    grid-column: 1 / -1;
  }
</style>
