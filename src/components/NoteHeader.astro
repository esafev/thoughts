---
import { formatDate } from '@/lib/date';

export interface Props {
  title: string;
  pubDate?: Date;
}

const { title, pubDate } = Astro.props;
---

<section>
  <h1>{title}</h1>
  {pubDate && <span>{formatDate(pubDate)}</span>}
</section>

<style>
  section {
    margin-block-end: 2em;
  }

  section h1 {
    margin-block: 1em .5em;
    font-size: 1.1em;
  }

  section span {
    color: var(--theme-sub-text);
  }
</style>
