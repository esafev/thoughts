---
import { SITE_TITLE } from '@/consts';

export interface Props {
  title?: string;
}

const { title } = Astro.props;
---

<header>
  {title ? (
    <h1>
      <a href='/'>
        {title === SITE_TITLE ? <span class='portrait' role='img' aria-label={title} /> : title}
      </a>
    </h1>
  ) : (
    <a href='/'>↩ Index</a>
  )}
</header>

<style>
  h1 {
    font-size: 1em;
  }

  a {
    text-decoration: none;
    color: var(--theme-sub-text);

    &:hover {
      color: var(--theme-sub-text);
    }

    &:focus-visible {
      color: var(--theme-bg);
    }
  }

  a:has(.portrait) {
    display: inline-block;
    vertical-align: top;

    &:focus-visible {
      background: none;
      box-shadow: none;
      color: var(--theme-sub-text);
      outline: 2px solid var(--theme-link-hover);
      outline-offset: 4px;
    }
  }

  .portrait {
    display: inline-block;
    vertical-align: top;
    width: 96px;
    height: 96px;

    background-color: currentColor;
    mask: url('/portrait-light.png') center / contain no-repeat;

    @media (prefers-color-scheme: dark) {
      mask-image: url('/portrait-dark.png');
    }
  }
</style>
