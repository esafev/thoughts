---
import { execSync } from 'node:child_process';
import { formatUpdatedDate } from '@/lib/date';

// Dependabot only touches package.json and bun.lock, so its bumps don't count as updates
let lastUpdatedDate: string;
try {
  const lastCommitDate = execSync('git log -1 --format=%cI -- src public', {
    encoding: 'utf8',
  }).trim();

  lastUpdatedDate = formatUpdatedDate(new Date(lastCommitDate));
} catch {
  lastUpdatedDate = 'unknown';
}
---

<span>Last updated: {lastUpdatedDate}</span>


<style>
  span {
    margin-top: .75em;

    color: var(--theme-sub-text);
    font-size: .95em;
  }
</style>
